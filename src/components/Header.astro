---
const pathname = new URL(Astro.request.url).pathname;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { name: 'Home', path: `${baseUrl}/` },
  { name: 'Apps', path: `${baseUrl}/apps` },
  { name: 'Resume', path: `${baseUrl}/resume` },
  { name: 'Blog', path: `${baseUrl}/blog` },
  { name: 'Download', path: `${baseUrl}/download` },
  { name: 'Contact', path: `${baseUrl}/contact` },
];
---

<header>
  <div class="container nav-wrapper">
    <a href={`${baseUrl}/`} class="logo">
      <span>Yaditio</span>
    </a>
    <nav>
      <ul class="nav-links">
        {navItems.map((item) => {
          const isActive = item.path === `${baseUrl}/` 
            ? (pathname === `${baseUrl}/` || pathname === `${baseUrl}`) 
            : pathname.startsWith(item.path);
          return (
            <li>
              <a href={item.path} class={isActive ? 'active' : ''}>
                {item.name}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
