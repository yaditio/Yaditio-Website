---
interface Props {
  slug: string;
  title: string;
  description?: string;
  date: string | Date;
  author?: string;
  tags?: string[];
}

const { slug, title, description, date, author, tags } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<div class="card">
  {tags && tags.length > 0 && <span class="card-tag">{tags[0]}</span>}
  <h3 class="card-title">
    <a href={`/blog/${slug}`}>{title}</a>
  </h3>
  <p class="card-desc">{description}</p>
  <div class="card-footer">
    <span>{formattedDate}</span>
    <a href={`/blog/${slug}`} class="btn btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">Read Article &rarr;</a>
  </div>
</div>
