---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadCard from '../components/DownloadCard.astro';
import { getCollection } from 'astro:content';

const downloads = await getCollection('downloads');
---

<BaseLayout title="Download Apps | Yaditio" description="Download software and engineering applications created by Yudha Sono Aditio.">
  <div style="margin-bottom: 2.5rem;">
    <h1>App <span class="gradient-text">Downloads</span></h1>
    <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 650px;">
      Explore and download open-source applications, tools, and releases. Content manageable via Pages CMS.
    </p>
  </div>

  <div class="grid" style="margin-bottom: 3.5rem;">
    {downloads.map((app) => (
      <DownloadCard
        slug={app.slug}
        title={app.data.title}
        description={app.data.description}
        version={app.data.version}
        repoUrl={app.data.repoUrl}
        downloadUrl={app.data.downloadUrl}
        category={app.data.category}
      />
    ))}
  </div>

  <!-- Detailed App Breakdowns -->
  <section style="display: flex; flex-direction: column; gap: 2rem;">
    {downloads.map(async (app) => {
      const { Content } = await app.render();
      return (
        <div class="card" style="padding: 2rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
            <div>
              <span class="card-tag">{app.data.category || 'Application'}</span>
              <h2 style="font-size: 1.75rem; margin-top: 0.25rem;">{app.data.title}</h2>
            </div>
            {app.data.version && <span style="font-family: var(--font-mono); background: var(--accent-subtle); color: var(--accent-glow); padding: 0.3rem 0.7rem; border-radius: 6px; font-weight: 600;">{app.data.version}</span>}
          </div>

          <div class="prose" style="margin: 0; max-width: 100%;">
            <Content />
          </div>

          <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
            {app.data.downloadUrl && (
              <a href={app.data.downloadUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Download Latest Release
              </a>
            )}
            {app.data.repoUrl && (
              <a href={app.data.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                GitHub Repository &nearr;
              </a>
            )}
          </div>
        </div>
      );
    })}
  </section>
</BaseLayout>
