---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const appsList = await getCollection('apps');
  return appsList.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={`${entry.data.title} | Apps`} description={entry.data.description}>
  <article style="max-width: 800px; margin: 0 auto;">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;">
      <a href="/apps" style="font-size: 0.9rem; margin-bottom: 1rem; display: inline-block;">&larr; Back to Apps</a>
      {entry.data.category && <span class="card-tag" style="display: block; margin-top: 0.5rem;">{entry.data.category}</span>}
      <h1 style="margin-top: 0.5rem;">{entry.data.title}</h1>
      {entry.data.description && <p style="font-size: 1.15rem; color: var(--text-muted);">{entry.data.description}</p>}

      <div style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap;">
        {entry.data.repoUrl && (
          <a href={entry.data.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            View on GitHub &nearr;
          </a>
        )}
        {entry.data.demoUrl && (
          <a href={entry.data.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Live Demo &nearr;
          </a>
        )}
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
