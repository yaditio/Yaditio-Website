---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import DownloadCard from '../components/DownloadCard.astro';
import { getCollection } from 'astro:content';

const appsList = await getCollection('apps');
const blogPosts = await getCollection('blog');
const downloads = await getCollection('downloads');

const featuredApps = appsList.slice(0, 2);
const recentPosts = blogPosts.slice(0, 2);
---

<BaseLayout title="Yudhasono Aditio (Yaditio) | Civil Technologist Portfolio & Apps">
  <!-- Hero Section -->
  <section style="padding: 3rem 0 2rem; border-bottom: 1px solid var(--border-color); margin-bottom: 3rem;">
    <span class="card-tag">Welcome to my site</span>
    <h1 style="font-size: 3.25rem; max-width: 800px; margin-top: 0.5rem;">
      Hi, I'm <span class="gradient-text">Yudhasono Aditio</span>
    </h1>
    <p style="font-size: 1.2rem; color: var(--text-muted); max-width: 760px; margin-bottom: 2rem; line-height: 1.7;">
      Experienced Civil Technologist with a strong background in various types of projects, including infrastructure (roads, bridges, and drainage systems), architectural works, and irrigation structures.
    </p>

    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <a href="/resume" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        View Resume
      </a>
      <a href="/download" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Download Apps
      </a>
      <a href="https://github.com/yaditio" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
        GitHub Profile
      </a>
      <a href="https://www.linkedin.com/in/yudhasonoaditio" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        LinkedIn
      </a>
    </div>
  </section>

  <!-- Apps Section -->
  <section style="margin-bottom: 3.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem;">
      <div>
        <h2>Featured <span class="gradient-text">Apps & Software</span></h2>
        <p style="color: var(--text-muted);">Engineering tools & BIM automation developments.</p>
      </div>
      <a href="/apps" style="font-weight: 600;">Explore All Apps &rarr;</a>
    </div>

    <div class="grid">
      {featuredApps.map((a) => (
        <DownloadCard
          slug={a.slug}
          title={a.data.title}
          description={a.data.description}
          category={a.data.category}
          repoUrl={a.data.repoUrl}
          downloadUrl={a.data.demoUrl || a.data.repoUrl}
        />
      ))}
    </div>
  </section>

  <!-- Downloadable Apps Section -->
  <section style="margin-bottom: 3.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem;">
      <div>
        <h2>Software <span class="gradient-text">Downloads</span></h2>
        <p style="color: var(--text-muted);">Open-source desktop applications ready for download.</p>
      </div>
      <a href="/download" style="font-weight: 600;">View Downloads Page &rarr;</a>
    </div>

    <div class="grid">
      {downloads.map((item) => (
        <DownloadCard
          slug={item.slug}
          title={item.data.title}
          description={item.data.description}
          version={item.data.version}
          repoUrl={item.data.repoUrl}
          downloadUrl={item.data.downloadUrl}
          category={item.data.category}
        />
      ))}
    </div>
  </section>

  <!-- Recent Blog Posts Section -->
  <section style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem;">
      <div>
        <h2>Latest <span class="gradient-text">Articles</span></h2>
        <p style="color: var(--text-muted);">Notes on civil engineering, BIM, and software automation.</p>
      </div>
      <a href="/blog" style="font-weight: 600;">Read All Posts &rarr;</a>
    </div>

    <div class="grid">
      {recentPosts.map((post) => (
        <BlogCard
          slug={post.slug}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          author={post.data.author}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>
</BaseLayout>
