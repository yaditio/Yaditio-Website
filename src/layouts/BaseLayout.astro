---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yaditio | Yudhasono Aditio Portfolio',
  description = 'Personal website, Civil Technologist resume, engineering software apps, and downloads by Yudhasono Aditio.',
} = Astro.props;

const faviconUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Critical CSS Variables -->
    <style>
      :root {
        --bg-main: #0a0d14;
        --bg-card: rgba(18, 24, 38, 0.75);
        --bg-card-hover: rgba(26, 35, 56, 0.85);
        --border-color: rgba(255, 255, 255, 0.1);
        --border-accent: rgba(59, 130, 246, 0.3);
        
        --text-main: #f3f4f6;
        --text-muted: #9ca3af;
        --text-dim: #6b7280;
        
        --accent-primary: #3b82f6;
        --accent-glow: #60a5fa;
        --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        --accent-subtle: rgba(59, 130, 246, 0.12);
        
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        
        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-lg: 20px;
        
        --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
        --shadow-glow: 0 0 25px rgba(59, 130, 246, 0.15);
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
