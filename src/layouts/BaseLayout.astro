---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yaditio | Yudhasono Aditio Portfolio',
  description = 'Personal website, Civil Technologist resume, engineering software apps, and downloads by Yudhasono Aditio.',
} = Astro.props;

const faviconUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Critical Dark Theme Fallback -->
    <style is:inline>
      html, body {
        background-color: #0a0d14 !important;
        color: #f3f4f6 !important;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body style="background-color: #0a0d14; color: #f3f4f6;">
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
